# Admin login — generate a fresh set with: npm run gen:admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:<salt>:<hash>
SESSION_SECRET=<64-char random hex>

# Secret for POST /api/sms/log — generate with:
#   node -e 'console.log("cks_" + require("crypto").randomBytes(24).toString("base64url"))'
SMS_API_KEY=cks_<random>

# Postgres connection string (Neon / Vercel Postgres / Supabase)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Guest login + push notifications ---
# Skip OTP checking until an SMS gateway is connected. Set to "false" to enforce it.
OTP_SKIP=true
SITE_URL=https://checkin.co.in

# Firebase service account (server side, for sending pushes)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase web app config (client side)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
